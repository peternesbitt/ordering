# Amazon Account Credentials
AMAZON_EMAIL=your_email@example.com
AMAZON_PASSWORD=your_password

# Scheduling
RUN_TIME=09:00

# Reminders List Name (optional - defaults to scanning all lists)
REMINDERS_LIST_NAME=Shopping

# Headless Mode (set to false to see browser automation)
HEADLESS=true

# Dry Run Mode (set to true to test without actually placing orders)
DRY_RUN=false
